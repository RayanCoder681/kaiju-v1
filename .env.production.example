# ─────────────────────────────────────────────────────────────
# Kaiju — variables d'environnement de PRODUCTION (hébergement en ligne).
# À définir dans le panneau de l'hébergeur (jamais commitées).
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Obligatoire : secret long et aléatoire (ex. `openssl rand -hex 48`).
SESSION_SECRET=

# Clé privée requise pour créer le premier compte organisateur (64 caractères hexadécimaux).
SETUP_KEY=

# URL publique de l'app, sans slash final. Rend le QR/les liens corrects.
# Ex. https://kaiju-votreamphi.up.railway.app  ou  https://kaiju.fly.dev
PUBLIC_URL=

# Derrière le reverse-proxy TLS de l'hébergeur : 1 proxy de confiance.
TRUST_PROXY=1

# Cookie sécurisé (HTTPS). Laisser vide = activé automatiquement en production.
# COOKIE_SECURE=true

# Chemins sur le VOLUME PERSISTANT monté par l'hébergeur (adapter au point de montage).
DATABASE_PATH=/data/kaiju.sqlite
BACKUP_DIR=/data/backups
UPLOAD_DIR=/data/uploads

# Langue par défaut
DEFAULT_LOCALE=fr

# Limites sûres (ajuster selon la taille réelle attendue en ligne)
MAX_PARTICIPANTS=200
MAX_IMAGE_BYTES=5242880
AUTO_BACKUP_MINUTES=10
RATE_WINDOW_MS=10000
RATE_MAX_ACTIONS=30
